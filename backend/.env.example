# Copy this file to .env and fill in the values for your environment:
#   cp .env.example .env
#
# Only DATABASE_URL is required to get the server running at all (in the
# default APP_MODE=simulation, no payment/router credentials are needed —
# everything resolves locally for demo/dev purposes). Everything else below
# becomes required only once you switch on the feature it belongs to.

# ── Database (required) ────────────────────────────────────────────────
# Postgres connection string. Run `npm run db:migrate` after setting this
# to create/update the schema.
DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/ungana"

# ── Server ──────────────────────────────────────────────────────────────
PORT=5000

# Secret used to sign activator/coordinator/admin login JWTs — set this to
# a long random string in any real deployment (the fallback below is only
# safe for local dev).
JWT_SECRET="change-me-to-a-long-random-string"

# Set true only in dev — enables POST /api/test-authorize, a dummy
# payment+authorise shortcut for testing without spending real money.
# Never enable this in production.
ENABLE_TEST_ROUTE=false

# 'simulation' (default, safe): no real STK push is sent, no money moves —
#   payments resolve locally after a short delay. Good for local dev/demo.
# 'active': real payments via PAYMENT_PROVIDER below, real router
#   authorisation via UNIFI_*, real BTC invoices via BTCPAY_* — actual
#   money moves. Only the credentials for the feature(s) you actually use
#   are required below.
APP_MODE=simulation

# ── UniFi controller (router-side authorisation) ───────────────────────
# Required only in APP_MODE=active, for granting real network access.
# Targets UniFi OS controllers (not the classic standalone controller).
# Leave UNIFI_URL unset to skip real router calls — sessions are still
# recorded in the database, just without contacting a router.
UNIFI_URL=                       # e.g. https://unifi.yourdomain.com
UNIFI_SITE=default
UNIFI_USERNAME=
UNIFI_PASSWORD=

# ── Payment provider selection ─────────────────────────────────────────
# Which real M-Pesa integration to use in APP_MODE=active. Only the
# credentials for the one you pick (below) are required.
PAYMENT_PROVIDER=paystack        # or: daraja

# ── Paystack (used when PAYMENT_PROVIDER=paystack) ─────────────────────
PAYSTACK_SECRET_KEY=
# PAYSTACK_EMAIL=owner@example.com   # optional; a rotating placeholder is generated otherwise

# ── Daraja / Safaricom M-Pesa (used when PAYMENT_PROVIDER=daraja) ──────
DARAJA_ENV=sandbox               # or: production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_TILL_NUMBER=              # only set if different from DARAJA_SHORTCODE — see config.js's comment (Agent/Store Till setups)
DARAJA_PASSKEY=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline   # or: CustomerBuyGoodsOnline — must match whether DARAJA_SHORTCODE is a PayBill or a Till number (a mismatch here fails STK pushes with ResultCode 2029 without ever reaching the customer's phone)
DARAJA_CALLBACK_URL=             # e.g. https://yourdomain.com/backend/api/webhook/daraja
DARAJA_ACCOUNT_REF=UNGANA

# ── Minmo Partner API ────────────────────────────────────────────────
# Requires Node >=22 for the @minmoto/sdk package itself. MINMO_STORE_ID
# must be a Pay store already connected to a wallet (see
# services/payments/minmo.js).
MINMO_PARTNER_ID="c9170e5c-32c5-4b9b-867e-36659d550541"
MINMO_API_KEY="8eaf436c-2be2-4f86-937f-95bf4b0978aa"
MINMO_STORE_ID=
MINMO_BASE_URL="https://pay.staging.minmo.to"                  # optional; defaults to Minmo's production API

# ── BTC / Lightning checkout (optional) ────────────────────────────────
# Independent of PAYMENT_PROVIDER above — BTC is a parallel checkout
# option offered alongside M-Pesa, not a replacement for it. Leave both
# providers unconfigured to keep using simulated Lightning invoices (no
# real account needed) even in APP_MODE=active.
BTC_PROVIDER=btcpay               # or: minmo — which real backend serves it (Minmo credentials are above)

# BTCPay Server (used when BTC_PROVIDER=btcpay)
BTCPAY_URL="https://pay.staging.minmo.to"                    # e.g. https://btcpay.yourdomain.com
BTCPAY_API_KEY="WQdWlGvpMII0bZbvHW0vBCHRUVdkvbEHvyiPk00C7B0"
BTCPAY_STORE_ID="5BTu82vef6GLBcCNUZRXDbFFmTp6dJpqecsH2S8gibUu"
BTCPAY_WEBHOOK_SECRET="5BTu82vef6GLBcCNUZRXDbFFmTp6dJpqecsH2S8gibUu"

# ── Deploy note: content image/video uploads ───────────────────────────
# Admin-uploaded content images/videos are stored on local disk at
# backend/uploads/ (see services/uploads.js) — there's no env var for
# this, it's not S3 or similar. That directory is gitignored on purpose
# (uploaded files aren't source), which means any deploy step that resets
# untracked files — `git clean -fdx`, a fresh checkout/rsync, redeploying
# from a clean image, etc. — silently deletes every previously uploaded
# file, and any content still pointing at one will start 404ing until
# re-uploaded. Exclude backend/uploads/ from whatever step does that, or
# point it at a mounted/persistent volume, if uploads need to survive
# deploys.
